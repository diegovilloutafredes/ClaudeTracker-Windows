{
  "sourceLanguage": "en",
  "strings": {
    "%@  pk %@  avg %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@  pico %@  prom %@"
          }
        }
      },
      "comment": "Chart stats row: current/hovered value, peak value, average value"
    },
    "%@ (retry in %ds)": {
      "comment": "Error message with retry countdown appended",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (reintentando en %ds)"
