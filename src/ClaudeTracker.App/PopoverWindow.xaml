<Window x:Class="ClaudeTracker.App.PopoverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Tracker"
        Width="340" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- Reads as a link, but is a real button: reachable by keyboard and by screen readers. -->
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Root" Padding="19" BorderThickness="1">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="HeaderTitle" DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="Badge" DockPanel.Dock="Right" CornerRadius="9" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock x:Name="BadgeText" FontSize="11" FontWeight="SemiBold" />
                </Border>
                <!-- Shown with two or more accounts: the active one's name, opening the list. -->
                <Button x:Name="AccountMenuButton" DockPanel.Dock="Right" Style="{StaticResource Link}"
                        FontSize="12" FontWeight="SemiBold" Margin="0,0,2,0" VerticalAlignment="Center" MaxWidth="150" />
            </DockPanel>
            <StackPanel x:Name="Body" Margin="0,17,0,0" />
            <Border x:Name="Divider" Height="1" Margin="0,17,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-3,-6,-3">
                <Button x:Name="SettingsLink" Style="{StaticResource Link}" FontSize="12" Margin="0,0,4,0" />
                <Button x:Name="QuitLink" Style="{StaticResource Link}" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
