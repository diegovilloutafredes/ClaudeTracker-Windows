<Window x:Class="ClaudeTracker.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeTracker.App"
        Width="560" MinWidth="460" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <!-- An on/off setting drawn the Windows 11 way: its text on the left, a switch on the
             right. It stays a CheckBox to the keyboard and to screen readers. Colours come
             from Foreground, which the code sets for light or dark. -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Grid DockPanel.Dock="Right" Width="40" Height="20" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Opacity="0.65"
                                        BorderBrush="{TemplateBinding Foreground}" />
                                <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left"
                                         Opacity="0.8" Fill="{TemplateBinding Foreground}" />
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{x:Static SystemColors.AccentColorBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{x:Static SystemColors.AccentColorBrush}" />
                                <Setter TargetName="Track" Property="Opacity" Value="1" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                                <Setter TargetName="Thumb" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,22">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="AccountHeader" DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="AddAccountButton" DockPanel.Dock="Right" Padding="12,5" FontSize="13" />
            </DockPanel>
            <StackPanel x:Name="AccountList" Margin="0,12,0,0" />
            <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
            <!-- Updates: a button to check, or what was found and what is being done about it. -->
            <Button x:Name="CheckUpdatesButton" HorizontalAlignment="Left" Padding="12,5" FontSize="13" Margin="0,16,0,0" />
            <DockPanel x:Name="UpdateFound" Margin="0,16,0,0" MinHeight="30">
                <Button x:Name="UpdateAction" DockPanel.Dock="Right" Padding="12,5" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                <local:SymbolText x:Name="UpdateSymbol" DockPanel.Dock="Left" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="UpdateText" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <StackPanel x:Name="InstalledOptions" Margin="0,8,0,0">
                <CheckBox x:Name="LaunchAtLoginSwitch" Style="{StaticResource Switch}" />
                <CheckBox x:Name="AutoUpdateSwitch" Style="{StaticResource Switch}" />
                <TextBlock x:Name="AutoUpdateCaption" FontSize="12" Margin="20,0,0,4" />
            </StackPanel>
            <DockPanel Margin="0,16,0,0" LastChildFill="True">
                <Button x:Name="OpenLogsButton" DockPanel.Dock="Left" Padding="12,5" FontSize="13" />
                <TextBlock x:Name="OpenLogsCaption" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
            <TextBlock x:Name="Disclaimer" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />

            <StackPanel x:Name="DisplaySection" Margin="0,26,0,0">
                <TextBlock x:Name="DisplayHeader" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DockPanel Margin="0,6" LastChildFill="False">
                    <TextBlock x:Name="TrayShowsLabel" DockPanel.Dock="Left" FontSize="14" VerticalAlignment="Center" />
                    <ComboBox x:Name="TrayShowsPicker" DockPanel.Dock="Right" MinWidth="190" FontSize="13" />
                </DockPanel>
                <DockPanel Margin="0,6">
                    <TextBlock x:Name="PopupSizeLabel" DockPanel.Dock="Left" FontSize="14" VerticalAlignment="Center" />
                    <local:QuietText x:Name="PopupSizeValue" DockPanel.Dock="Right" FontSize="13" Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                    <Slider x:Name="PopupSizeSlider" Margin="18,0,0,0" VerticalAlignment="Center" IsSnapToTickEnabled="True" />
                </DockPanel>
                <CheckBox x:Name="ShowChartsSwitch" Style="{StaticResource Switch}" />
                <CheckBox x:Name="ShowModelsSwitch" Style="{StaticResource Switch}" />
                <CheckBox x:Name="ShowPaceSwitch" Style="{StaticResource Switch}" />
                <CheckBox x:Name="ShowTrayPaceSwitch" Style="{StaticResource Switch}" />
                <DockPanel x:Name="RateUnitRow" Margin="20,6,0,6" LastChildFill="False">
                    <TextBlock x:Name="RateUnitLabel" DockPanel.Dock="Left" FontSize="14" VerticalAlignment="Center" />
                    <ComboBox x:Name="RateUnitPicker" DockPanel.Dock="Right" MinWidth="190" FontSize="13" />
                </DockPanel>
                <DockPanel Margin="0,6" LastChildFill="False">
                    <TextBlock x:Name="TimeFormatLabel" DockPanel.Dock="Left" FontSize="14" VerticalAlignment="Center" />
                    <ComboBox x:Name="TimeFormatPicker" DockPanel.Dock="Right" MinWidth="190" FontSize="13" />
                </DockPanel>
            </StackPanel>

            <StackPanel x:Name="ResetSection" Margin="0,26,0,0">
                <TextBlock x:Name="ResetHeader" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox x:Name="Notify5HourSwitch" Style="{StaticResource Switch}" />
                <CheckBox x:Name="Notify7DaySwitch" Style="{StaticResource Switch}" />
                <CheckBox x:Name="ResetToastSwitch" Style="{StaticResource Switch}" />
                <StackPanel x:Name="ResetToastOptions" Margin="20,0,0,0">
                    <DockPanel Margin="0,6">
                        <TextBlock x:Name="ResetDurationLabel" DockPanel.Dock="Left" FontSize="14" VerticalAlignment="Center" />
                        <local:QuietText x:Name="ResetDurationValue" DockPanel.Dock="Right" FontSize="13" Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="ResetDurationSlider" Margin="18,0,0,0" VerticalAlignment="Center" IsSnapToTickEnabled="True" />
                    </DockPanel>
                    <CheckBox x:Name="ResetPermanentSwitch" Style="{StaticResource Switch}" />
                </StackPanel>
                <CheckBox x:Name="ResetSoundSwitch" Style="{StaticResource Switch}" />
                <DockPanel Margin="0,8,0,0">
                    <Button x:Name="ResetTestButton" DockPanel.Dock="Left" Padding="12,5" FontSize="13" />
                    <TextBlock x:Name="ResetTestCaption" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>

            <StackPanel x:Name="PaceSection" Margin="0,26,0,0">
                <TextBlock x:Name="PaceHeader" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox x:Name="NotifyPaceSwitch" Style="{StaticResource Switch}" />
                <StackPanel x:Name="PaceOptions">
                    <DockPanel Margin="0,6">
                        <TextBlock x:Name="WarningLabel" DockPanel.Dock="Left" FontSize="14" VerticalAlignment="Center" />
                        <local:QuietText x:Name="WarningValue" DockPanel.Dock="Right" FontSize="13" Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="WarningSlider" Margin="18,0,0,0" VerticalAlignment="Center" IsSnapToTickEnabled="True" />
                    </DockPanel>
                    <CheckBox x:Name="PaceToastSwitch" Style="{StaticResource Switch}" />
                    <StackPanel x:Name="PaceToastOptions" Margin="20,0,0,0">
                        <DockPanel Margin="0,6">
                            <TextBlock x:Name="PaceDurationLabel" DockPanel.Dock="Left" FontSize="14" VerticalAlignment="Center" />
                            <local:QuietText x:Name="PaceDurationValue" DockPanel.Dock="Right" FontSize="13" Width="46" TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="PaceDurationSlider" Margin="18,0,0,0" VerticalAlignment="Center" IsSnapToTickEnabled="True" />
                        </DockPanel>
                        <CheckBox x:Name="PacePermanentSwitch" Style="{StaticResource Switch}" />
                    </StackPanel>
                    <CheckBox x:Name="PaceSoundSwitch" Style="{StaticResource Switch}" />
                    <DockPanel Margin="0,8,0,0">
                        <Button x:Name="PaceTestButton" DockPanel.Dock="Left" Padding="12,5" FontSize="13" />
                        <TextBlock x:Name="PaceTestCaption" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
                <TextBlock x:Name="PaceCaption" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
