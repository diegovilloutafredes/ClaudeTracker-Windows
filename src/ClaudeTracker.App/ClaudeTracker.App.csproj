<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for NotifyIcon (the tray icon) and System.Drawing (drawing it). -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClaudeTracker</AssemblyName>
    <RootNamespace>ClaudeTracker.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF0001: Application.ThemeMode (the Windows 11 look, light and dark) is still marked experimental.
         WFO0003: Windows Forms wants DPI awareness set through its own startup API, which a WPF
         app never calls; the manifest is how WPF gets per-monitor DPI. -->
    <NoWarn>$(NoWarn);WPF0001;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- With WPF and Windows Forms both on, these implicit usings make Application, Color,
         Brush and others ambiguous. Windows Forms types are named through an alias instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <ProjectReference Include="..\ClaudeTracker.Core\ClaudeTracker.Core.csproj" />
  </ItemGroup>

</Project>
