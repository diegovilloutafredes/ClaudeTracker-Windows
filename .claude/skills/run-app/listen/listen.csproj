<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UiaListen</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The COM face of UI Automation, which is what Narrator itself uses: the managed
         client that PowerShell reaches knows neither heading levels nor notifications. -->
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>
</Project>
